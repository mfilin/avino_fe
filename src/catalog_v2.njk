{% block heading %}
    <div class="heading">
        <div class="heading__body">
            <div class="container">
                <div class="heading__main">
                    <div class="heading__breadcrumb">
                        <ol class="breadcrumb breadcrumb--white">
                            <li class="breadcrumb__item">
                                <a href="#" class="breadcrumb__link">Главная</a>
                            </li>
                            <li class="breadcrumb__item">
                                <span class="breadcrumb__active">{{ title }}</span>
                            </li>
                        </ol>
                    </div>
                    <div class="heading__content">
                        <h1 class="heading__title">{{ title }}</h1>
                        <div class="heading__text">
                            Из рислинга получаются вина непревзойденного качества, вина изысканные, аристократические и, как это не смешно, немодные», — отмечала критик Дженсис Робинсон в книге «Vines, Grapes & Wines».
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="heading__media heading__media--sm">
            <img src="img/heading_image_sm.jpg" class="img-cover" alt="">
        </div>
        <div class="heading__media heading__media--md">
            <img src="img/heading_image.jpg" class="img-cover" alt="">
        </div>
    </div>
{% endblock %}


